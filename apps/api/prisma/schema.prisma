generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  firstName    String
  surname      String
  passwordHash String
  role         UserRole @default(USER)
}
